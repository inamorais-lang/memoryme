      "Edit(~/.claude/channels/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(**/.env*)",
      "Edit(.claude/settings*.json)",
      "Edit(bin/**)",
      "Edit(systemd/**)",
      "Edit(scheduler/**)"
    ]
