# Copia para .env.local e preenche. Este ficheiro NÃO vai para o git.
# O teu id numérico do Telegram (pede ao @userinfobot).
TELEGRAM_CHAT_ID=
# Fuso horário dos lembretes e rotinas.
TZ=Europe/Lisbon
# Nome do assistente: usado no screen e nos serviços (assistente-session, ...).
ASSISTANT_NAME=assistente
# Pastas onde o assistente pode trabalhar, além desta (separadas por ":"). Por omissão: a raiz do repositório memoryme.
ALLOWED_DIRS=
# 0 desliga os alertas de saúde.
HEALTHCHECK=1
# auto | 0 | 1 — manter a máquina acordada (num VPS não é preciso).
KEEP_AWAKE=auto
