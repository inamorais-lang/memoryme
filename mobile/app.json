{
  "expo": {
    "name": "PetBubble",
    "slug": "petbubble",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "petbubble",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "pt-PT",
        "CFBundleAllowMixedLocalizations": true
      },
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "bundleIdentifier": "app.petbubble"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#C8F53A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#C8F53A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "A câmara é usada para tirares uma foto ao teu animal e criares uma imagem com o que ele está a pensar.",
          "photosPermission": "O acesso às fotos é usado para escolheres uma foto do teu animal e criares a imagem.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "O acesso às fotos é usado para escolheres uma foto do teu animal e criares a imagem.",
          "savePhotosPermission": "O acesso às fotos é usado para guardares as tuas imagens no rolo da câmara.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-sharing",
      "expo-localization",
      "expo-sqlite",
      "expo-font",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-iap",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "pt-PT": "./locales/ios/pt-PT.json",
      "en": "./locales/ios/en.json",
      "es": "./locales/ios/es.json",
      "fr": "./locales/ios/fr.json"
    },
    "owner": "inamoraiss-team",
    "extra": {
      "eas": {
        "projectId": "648c25fd-1511-484a-93a8-a8243998bbad"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/648c25fd-1511-484a-93a8-a8243998bbad"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
