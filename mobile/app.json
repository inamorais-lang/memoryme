{
  "expo": {
    "name": "Pensamentos do Bicho",
    "slug": "pet-thoughts",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "petthoughts",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "pt-PT",
        "CFBundleAllowMixedLocalizations": true
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF4E6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "A câmara é usada para tirares uma foto ao teu animal e criares a tradução do que ele está a pensar.",
          "photosPermission": "O acesso às fotos é usado para escolheres uma foto do teu animal e criares a tradução.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "O acesso às fotos é usado para escolheres uma foto do teu animal e criares a tradução.",
          "savePhotosPermission": "O acesso às fotos é usado para guardares as tuas traduções no rolo da câmara.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-sharing",
      "expo-localization",
      "expo-sqlite",
      "expo-font",
      "expo-secure-store",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "pt-PT": "./locales/ios/pt-PT.json",
      "en": "./locales/ios/en.json"
    }
  }
}
